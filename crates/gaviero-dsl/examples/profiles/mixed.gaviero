// Model profile: tiers spread across providers.

client flash { model "dsh:deepseek-flash"  privacy public effort high }
client terra { model "codex:gpt-6.1-terra" privacy public effort medium }
client opus  { model "claude:opus"         privacy public effort high }
client fable { model "claude:fable"        privacy public effort max }

tier low    flash
tier medium terra
tier high   opus
tier top    fable
