// Shared client profiles for example workflows.
//
// Model strings use the canonical `provider:model` form (validated at
// dispatch by gaviero-core). `tier` is omitted here: these examples bind
// agents to concrete clients by name (`client opus`). Add top-level
// `tier <alias> <client>` declarations when you want re-pointable routing.

client fable {
    model "claude:fable"
    privacy public
    effort max
    default
}

client opus {
    model "claude:opus"
    privacy public
    effort max
}

client sonnet {
    model "claude:sonnet"
    privacy public
    // The judge emits a short JSON verdict — no deep reasoning needed.
    effort medium
}

client codex-6-1-sol {
    model "codex:gpt-6.1-sol"
    privacy public
    // Codex's latest workhorse (catalog priority 1).
    effort high
}

client codex-6-1-terra {
    model "codex:gpt-6.1-terra"
    privacy public
    effort high
}

client codex-6-luna {
    model "codex:gpt-6-luna"
    privacy public
    // Luna tops out at max; it has no `ultra`.
    effort medium
}

client codex-6-astra {
    model "codex:gpt-6-astra"
    privacy public
    // Codex's frontier model. Older CLIs are served a catalog without it.
    effort high
}

client codex-5-6-sol {
    model "codex:gpt-5.6-sol"
    privacy public
    // Astra, Sol and Terra are the Codex models that accept `ultra`.
    effort high
}

client codex-5-6-terra {
    model "codex:gpt-5.6-terra"
    privacy public
    effort high
}

client codex-5-6-luna {
    model "codex:gpt-5.6-luna"
    privacy public
    effort medium
}

client composer {
    model "cursor:composer-2.5"
    privacy public
}

client grok {
    // Cursor CLI id embeds effort (`agent --list-models`); grok-4.7 is the
    // current grok generation — use the full id.
    model "cursor:grok-4.7-high"
    privacy public
}

client dsh {
    // DeepSeek via `dsh --profile acp` (npm `@deepseek-ai/dsh`) over the
    // Agent Client Protocol; needs DEEPSEEK_API_KEY. `deepseek-flash` is
    // V4.1-Flash (canonical API id).
    model "dsh:deepseek-flash"
    privacy public
    effort high
}
