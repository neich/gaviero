// Shared client profiles for example workflows.
//
// Model strings use the canonical `provider:model` form (validated at
// dispatch by gaviero-core). `tier` is omitted here: these examples bind
// agents to concrete clients by name (`client opus`). Add top-level
// `tier <alias> <client>` declarations when you want re-pointable routing.

client fable {
    model "claude:fable"
    privacy public
    effort max
    default
}

client opus {
    model "claude:opus"
    privacy public
    effort max
}

client sonnet {
    model "claude:sonnet"
    privacy public
    // The judge emits a short JSON verdict — no deep reasoning needed.
    effort medium
}

client codex-5-5 {
    model "codex:gpt-5.5"
    privacy public
    // gpt-5.5 ceiling is xhigh; high is the everyday default.
    effort high
}

client codex-6-astra {
    model "codex:gpt-6-astra"
    privacy public
    // Current Codex flagship (catalog priority 1). Needs Codex CLI >= 0.153;
    // older clients are served a catalog without it.
    effort high
}

client codex-5-6-sol {
    model "codex:gpt-5.6-sol"
    privacy public
    // Astra, Sol and Terra are the Codex models that accept `ultra`.
    effort high
}

client codex-5-6-terra {
    model "codex:gpt-5.6-terra"
    privacy public
    effort high
}

client codex-5-6-luna {
    model "codex:gpt-5.6-luna"
    privacy public
    effort medium
}

client codex-5-4-mini {
    // gpt-5.4 was delisted upstream; mini is the surviving 5.4 entry.
    model "codex:gpt-5.4-mini"
    privacy public
    effort medium
}

client composer {
    model "cursor:composer-2.5"
    privacy public
    effort medium
}

client grok {
    // Cursor CLI id embeds effort (`agent --list-models`); use the full id.
    model "cursor:cursor-grok-4.6-high"
    privacy public
    effort high
}

client dsh {
    // DeepSeek via `dsh --profile acp` (npm `@deepseek-ai/dsh`) over the
    // Agent Client Protocol; needs DEEPSEEK_API_KEY. `deepseek-flash` is
    // V4.1-Flash (canonical API id).
    model "dsh:deepseek-flash"
    privacy public
    effort high
}
